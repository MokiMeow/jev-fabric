{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "groupId",
    "track",
    "split",
    "goldRoute",
    "lookaheadProbe",
    "evaluationNow",
    "trustedProjection",
    "untrustedEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "groupId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "track": {
      "enum": [
        "market_surveillance",
        "visual_evidence",
        "financial_text_triage"
      ]
    },
    "split": { "enum": ["calibration", "test"] },
    "goldRoute": { "enum": ["observe", "investigate", "escalate"] },
    "lookaheadProbe": { "type": "boolean" },
    "evaluationNow": { "type": "string", "format": "date-time" },
    "trustedProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentRef",
        "assetClass",
        "venue",
        "sourceId",
        "sourceHash",
        "featureSetId",
        "featureSetVersion",
        "featureSetHash",
        "observedAt",
        "windowStart",
        "windowEnd",
        "cutoffAt",
        "maxAgeMs",
        "signals"
      ],
      "properties": {
        "instrumentRef": {
          "type": "string",
          "pattern": "^ref:[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "assetClass": {
          "enum": [
            "equity",
            "etf",
            "future",
            "option",
            "fx",
            "fixed_income",
            "fund",
            "crypto",
            "other"
          ]
        },
        "venue": { "$ref": "#/$defs/identifier" },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "featureSetId": { "$ref": "#/$defs/identifier" },
        "featureSetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "featureSetHash": { "$ref": "#/$defs/hash" },
        "observedAt": { "type": "string", "format": "date-time" },
        "windowStart": { "type": "string", "format": "date-time" },
        "windowEnd": { "type": "string", "format": "date-time" },
        "cutoffAt": { "type": "string", "format": "date-time" },
        "maxAgeMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "bucket",
              "definitionHash",
              "evidenceHash",
              "asOf"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "bucket": {
                "enum": ["low", "normal", "elevated", "extreme", "unknown"]
              },
              "definitionHash": { "$ref": "#/$defs/hash" },
              "evidenceHash": { "$ref": "#/$defs/hash" },
              "asOf": { "type": "string", "format": "date-time" }
            }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "extractorId",
            "extractorVersion",
            "imageHash",
            "axesVerified",
            "sourceBindingHash"
          ],
          "properties": {
            "mode": { "const": "structured_extraction" },
            "extractorId": { "$ref": "#/$defs/identifier" },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "imageHash": { "$ref": "#/$defs/hash" },
            "axesVerified": { "const": true },
            "sourceBindingHash": { "$ref": "#/$defs/hash" }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "extractorId",
            "extractorVersion",
            "documentHash",
            "sourceBindingHash"
          ],
          "properties": {
            "mode": { "const": "bounded_excerpts" },
            "extractorId": { "$ref": "#/$defs/identifier" },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "documentHash": { "$ref": "#/$defs/hash" },
            "sourceBindingHash": { "$ref": "#/$defs/hash" }
          }
        }
      }
    },
    "untrustedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["annotations"],
          "properties": {
            "annotations": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "maxLength": 240 }
            }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["excerpts"],
          "properties": {
            "excerpts": {
              "type": "array",
              "maxItems": 16,
              "items": { "type": "string", "maxLength": 1000 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
