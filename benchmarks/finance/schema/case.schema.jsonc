{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "groupId",
    "track",
    "split",
    "goldRoute",
    "lookaheadProbe",
    "evaluationNow",
    "trustedProjection",
    "untrustedEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "groupId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "track": {
      "enum": [
        "market_surveillance",
        "visual_evidence",
        "financial_text_triage"
      ]
    },
    "split": { "enum": ["calibration", "test"] },
    "goldRoute": { "enum": ["observe", "investigate", "escalate"] },
    "lookaheadProbe": { "type": "boolean" },
    "evaluationNow": { "type": "string", "format": "date-time" },
    "trustedProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentRef",
        "assetClass",
        "venue",
        "sourceId",
        "sourceHash",
        "featureSetId",
        "featureSetVersion",
        "featureSetHash",
        "observedAt",
        "windowStart",
        "windowEnd",
        "cutoffAt",
        "maxAgeMs",
        "signals"
      ],
      "properties": {
        "instrumentRef": {
          "type": "string",
          "pattern": "^ref:[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "assetClass": {
          "enum": [
            "equity",
            "etf",
            "future",
            "option",
            "fx",
            "fixed_income",
            "fund",
            "crypto",
            "other"
          ]
        },
        "venue": { "$ref": "#/$defs/identifier" },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "featureSetId": { "$ref": "#/$defs/identifier" },
        "featureSetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "featureSetHash": { "$ref": "#/$defs/hash" },
        "observedAt": { "type": "string", "format": "date-time" },
        "windowStart": { "type": "string", "format": "date-time" },
        "windowEnd": { "type": "string", "format": "date-time" },
        "cutoffAt": { "type": "string", "format": "date-time" },
        "maxAgeMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "bucket",
              "definitionHash",
              "evidenceHash",
              "asOf"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "bucket": {
                "enum": ["low", "normal", "elevated", "extreme", "unknown"]
              },
              "definitionHash": { "$ref": "#/$defs/hash" },
              "evidenceHash": { "$ref": "#/$defs/hash" },
              "asOf": { "type": "string", "format": "date-time" }
            }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "extractorId",
            "extractorVersion",
            "imageHash",
            "axesVerified",
            "sourceBindingHash",
            "schemaVersion",
            "renderer",
            "mutationId",
            "expectedRoute",
            "artifactBindingHash"
          ],
          "properties": {
            "mode": { "const": "structured_extraction" },
            "extractorId": { "$ref": "#/$defs/identifier" },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "imageHash": { "$ref": "#/$defs/hash" },
            "axesVerified": { "const": true },
            "sourceBindingHash": { "$ref": "#/$defs/hash" },
            "schemaVersion": { "const": "1" },
            "renderer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "schemaVersion",
                "mutationPolicyId"
              ],
              "properties": {
                "id": { "const": "finance.canonical-svg" },
                "version": { "const": "1" },
                "schemaVersion": { "const": "1" },
                "mutationPolicyId": { "const": "finance.visual-mutations.v1" }
              }
            },
            "mutationId": {
              "enum": [
                "faithful_render",
                "missing_source_date",
                "missing_units",
                "swapped_series_legend",
                "truncated_zero_baseline"
              ]
            },
            "expectedRoute": {
              "enum": ["observe", "investigate", "escalate"]
            },
            "artifactBindingHash": { "$ref": "#/$defs/hash" }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "extractorId",
            "extractorVersion",
            "documentHash",
            "sourceBindingHash",
            "candidateBindings"
          ],
          "properties": {
            "mode": { "const": "bounded_excerpts" },
            "extractorId": { "$ref": "#/$defs/identifier" },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "documentHash": { "$ref": "#/$defs/hash" },
            "sourceBindingHash": { "$ref": "#/$defs/hash" },
            "candidateBindings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "excerptHash"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,63}$"
                  },
                  "excerptHash": { "$ref": "#/$defs/hash" }
                }
              }
            }
          }
        }
      }
    },
    "untrustedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["annotations"],
          "properties": {
            "annotations": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "maxLength": 240 }
            }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["excerpts"],
          "properties": {
            "excerpts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "maxLength": 1000 }
            }
          }
        }
      }
    },
    "visualArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["svgPath", "compilerInput"],
      "properties": {
        "svgPath": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._-]+\\.svg$",
          "maxLength": 240
        },
        "compilerInput": { "$ref": "#/$defs/visualCompilerInput" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "visualCompilerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "title",
        "axis",
        "source",
        "series",
        "mutationId"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "axis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xLabel", "yLabel", "units", "zeroBaseline"],
          "properties": {
            "xLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
            "yLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
            "units": { "type": "string", "minLength": 1, "maxLength": 40 },
            "zeroBaseline": { "const": true }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "publisher", "url", "date", "sha256"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "publisher": { "type": "string", "minLength": 1, "maxLength": 120 },
            "url": { "type": "string", "format": "uri", "maxLength": 2048 },
            "date": { "type": "string", "format": "date" },
            "sha256": { "$ref": "#/$defs/hash" }
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "points"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "points": {
                "type": "array",
                "minItems": 2,
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["timestamp", "value"],
                  "properties": {
                    "timestamp": { "type": "string", "format": "date-time" },
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "mutationId": {
          "enum": [
            "faithful_render",
            "missing_source_date",
            "missing_units",
            "swapped_series_legend",
            "truncated_zero_baseline"
          ]
        },
        "annotations": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
