{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "executionState",
    "sampleCount",
    "traceCount",
    "traceSetHash",
    "dataset",
    "runtime",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "executionState": { "enum": ["NOT_RUN", "COMPLETED"] },
    "sampleCount": { "type": "integer", "minimum": 0 },
    "traceCount": { "type": "integer", "minimum": 0 },
    "traceSetHash": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "datasetId",
        "sourceUrl",
        "digest",
        "license",
        "evidenceClass",
        "redistributionAllowed",
        "splitMethod",
        "trainEnd",
        "testStart"
      ],
      "properties": {
        "status": { "enum": ["NOT_SELECTED", "RETAINED"] },
        "datasetId": { "type": ["string", "null"], "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "digest": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "license": { "type": ["string", "null"], "minLength": 1 },
        "evidenceClass": {
          "anyOf": [
            { "type": "null" },
            { "enum": ["SYNTHETIC", "LOCAL_EXPLORATORY", "RETAINED_PUBLIC"] }
          ]
        },
        "redistributionAllowed": { "type": ["boolean", "null"] },
        "splitMethod": { "const": "forward_chaining_time_split" },
        "trainEnd": { "type": ["string", "null"], "format": "date-time" },
        "testStart": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionSetHash",
        "policyVersion",
        "featureSetHash",
        "hardware",
        "region",
        "concurrency",
        "timeoutMs",
        "architectures"
      ],
      "properties": {
        "questionSetHash": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "policyVersion": { "type": ["string", "null"], "minLength": 1 },
        "featureSetHash": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "hardware": { "type": ["string", "null"], "minLength": 1 },
        "region": { "type": ["string", "null"], "minLength": 1 },
        "concurrency": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 16
        },
        "timeoutMs": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 300000
        },
        "architectures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic_only",
            "host_model_only",
            "jev_advisory",
            "host_plus_jev"
          ],
          "properties": {
            "deterministic_only": { "$ref": "#/$defs/architectureRuntime" },
            "host_model_only": { "$ref": "#/$defs/architectureRuntime" },
            "jev_advisory": { "$ref": "#/$defs/architectureRuntime" },
            "host_plus_jev": { "$ref": "#/$defs/architectureRuntime" }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track",
          "architecture",
          "sampleCount",
          "calibrationStatus",
          "calibrationReason",
          "accountingStatus",
          "accountingReason",
          "metrics"
        ],
        "properties": {
          "track": {
            "enum": [
              "market_surveillance",
              "visual_evidence",
              "financial_text_triage"
            ]
          },
          "architecture": {
            "enum": [
              "deterministic_only",
              "host_model_only",
              "jev_advisory",
              "host_plus_jev"
            ]
          },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "calibrationStatus": {
            "enum": ["NOT_RUN", "measured", "unavailable"]
          },
          "calibrationReason": {
            "anyOf": [
              { "type": "null" },
              { "const": "no_measured_route_question_distributions" }
            ]
          },
          "accountingStatus": { "enum": ["NOT_RUN", "MEASURED", "UNMETERED"] },
          "accountingReason": {
            "anyOf": [{ "type": "null" }, { "const": "unmetered_attempt" }]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accuracy",
              "macroF1",
              "routeQuestionBrier",
              "routeQuestionEce",
              "coverage",
              "unsafeExecutionAttemptRate",
              "lookaheadRejectionRate",
              "p50Ms",
              "p95Ms",
              "inputTokens",
              "estimatedCostUsd"
            ],
            "properties": {
              "accuracy": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "macroF1": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "routeQuestionBrier": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "routeQuestionEce": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "coverage": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "unsafeExecutionAttemptRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "lookaheadRejectionRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "p50Ms": { "type": ["number", "null"], "minimum": 0 },
              "p95Ms": { "type": ["number", "null"], "minimum": 0 },
              "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
              "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "architectureRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "combinerId", "combinerVersion"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "providerId",
              "modelId",
              "modelVersion",
              "probabilitySemantics"
            ],
            "properties": {
              "role": { "enum": ["deterministic", "host", "jev"] },
              "providerId": { "type": ["string", "null"], "minLength": 1 },
              "modelId": { "type": ["string", "null"], "minLength": 1 },
              "modelVersion": { "type": ["string", "null"], "minLength": 1 },
              "probabilitySemantics": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "enum": [
                      "none",
                      "native_calibrated",
                      "normalized_logits",
                      "self_reported",
                      "synthetic",
                      "unknown"
                    ]
                  }
                ]
              }
            }
          }
        },
        "combinerId": { "type": ["string", "null"], "minLength": 1 },
        "combinerVersion": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
