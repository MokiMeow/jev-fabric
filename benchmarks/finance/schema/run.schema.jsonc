{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "executionState": { "const": "NOT_RUN" } },
        "required": ["executionState"]
      },
      "then": {
        "properties": {
          "sampleCount": { "const": 0 },
          "calibrationSampleCount": { "const": 0 },
          "traceCount": { "const": 0 },
          "traceSetHash": { "type": "null" },
          "counterfactuals": { "$ref": "#/$defs/counterfactualsNotRun" },
          "dataset": { "$ref": "#/$defs/notRunDataset" },
          "runtime": { "$ref": "#/$defs/notRunRuntime" },
          "observeGate": { "$ref": "#/$defs/observeGateNotRun" },
          "probabilityComparisons": {
            "type": "array",
            "maxItems": 0
          },
          "rows": {
            "type": "array",
            "items": { "$ref": "#/$defs/notRunRow" }
          }
        }
      },
      "else": {
        "properties": {
          "sampleCount": { "type": "integer", "minimum": 1 },
          "calibrationSampleCount": { "type": "integer", "minimum": 1 },
          "traceCount": { "type": "integer", "minimum": 24 },
          "traceSetHash": { "$ref": "#/$defs/hash" },
          "counterfactuals": { "$ref": "#/$defs/counterfactualsCompleted" },
          "observeGate": { "$ref": "#/$defs/observeGateCompleted" },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["intervals"],
              "properties": {
                "intervals": { "$ref": "#/$defs/financeIntervals" }
              }
            }
          },
          "probabilityComparisons": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "runId",
    "executionState",
    "sampleCount",
    "calibrationSampleCount",
    "traceCount",
    "traceSetHash",
    "counterfactuals",
    "dataset",
    "runtime",
    "uncertaintyConfiguration",
    "observeGate",
    "probabilityComparisons",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "const": "4" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "executionState": { "enum": ["NOT_RUN", "COMPLETED"] },
    "sampleCount": { "type": "integer", "minimum": 0 },
    "calibrationSampleCount": { "type": "integer", "minimum": 0 },
    "traceCount": { "type": "integer", "minimum": 0 },
    "traceSetHash": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      ]
    },
    "counterfactuals": {
      "oneOf": [
        { "$ref": "#/$defs/counterfactualsNotRun" },
        { "$ref": "#/$defs/counterfactualsCompleted" }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "datasetId",
        "sourceUrl",
        "digest",
        "license",
        "evidenceClass",
        "redistributionAllowed",
        "splitMethod",
        "trainEnd",
        "testStart"
      ],
      "properties": {
        "status": { "enum": ["NOT_SELECTED", "RETAINED"] },
        "datasetId": { "type": ["string", "null"], "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "digest": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "license": { "type": ["string", "null"], "minLength": 1 },
        "evidenceClass": {
          "anyOf": [
            { "type": "null" },
            { "enum": ["SYNTHETIC", "LOCAL_EXPLORATORY", "RETAINED_PUBLIC"] }
          ]
        },
        "redistributionAllowed": { "type": ["boolean", "null"] },
        "splitMethod": { "const": "forward_chaining_time_split" },
        "trainEnd": { "type": ["string", "null"], "format": "date-time" },
        "testStart": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionSetHash",
        "policyVersion",
        "featureSetHash",
        "hardware",
        "region",
        "concurrency",
        "timeoutMs",
        "architectures"
      ],
      "properties": {
        "questionSetHash": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "policyVersion": { "type": ["string", "null"], "minLength": 1 },
        "featureSetHash": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "hardware": { "type": ["string", "null"], "minLength": 1 },
        "region": { "type": ["string", "null"], "minLength": 1 },
        "concurrency": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 16
        },
        "timeoutMs": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 300000
        },
        "architectures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic_only",
            "host_model_only",
            "jev_advisory",
            "host_plus_jev"
          ],
          "properties": {
            "deterministic_only": { "$ref": "#/$defs/architectureRuntime" },
            "host_model_only": { "$ref": "#/$defs/architectureRuntime" },
            "jev_advisory": { "$ref": "#/$defs/architectureRuntime" },
            "host_plus_jev": { "$ref": "#/$defs/architectureRuntime" }
          }
        }
      }
    },
    "uncertaintyConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidenceLevel",
        "replicates",
        "seed",
        "clusterUnit"
      ],
      "properties": {
        "method": { "const": "cluster_percentile" },
        "confidenceLevel": { "const": 0.95 },
        "replicates": { "const": 2000 },
        "seed": { "const": 20260920 },
        "clusterUnit": { "const": "groupId" }
      }
    },
    "observeGate": {
      "oneOf": [
        { "$ref": "#/$defs/observeGateNotRun" },
        { "$ref": "#/$defs/observeGateCompleted" }
      ]
    },
    "probabilityComparisons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/probabilityComparison" }
    },
    "rows": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track",
          "architecture",
          "sampleCount",
          "calibrationTraceCount",
          "testTraceCount",
          "routeQuestionMetricTarget",
          "atomicMetrics",
          "calibrationStatus",
          "calibrationReason",
          "tokenAccountingStatus",
          "tokenAccountingReason",
          "costAccountingStatus",
          "costAccountingReason",
          "metrics"
        ],
        "properties": {
          "track": {
            "enum": [
              "market_surveillance",
              "visual_evidence",
              "financial_text_triage"
            ]
          },
          "architecture": {
            "enum": [
              "deterministic_only",
              "host_model_only",
              "jev_advisory",
              "host_plus_jev"
            ]
          },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "calibrationTraceCount": { "type": "integer", "minimum": 0 },
          "testTraceCount": { "type": "integer", "minimum": 0 },
          "routeQuestionMetricTarget": {
            "type": ["string", "null"],
            "enum": ["atomic_gold_finance_route", null]
          },
          "atomicMetrics": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/atomicMetricLedger" }
          },
          "intervals": { "$ref": "#/$defs/financeIntervals" },
          "calibrationStatus": {
            "enum": ["NOT_RUN", "measured", "unavailable"]
          },
          "calibrationReason": {
            "anyOf": [
              { "type": "null" },
              { "const": "no_measured_route_question_distributions" }
            ]
          },
          "tokenAccountingStatus": {
            "enum": ["NOT_RUN", "MEASURED", "UNMETERED"]
          },
          "tokenAccountingReason": {
            "anyOf": [{ "type": "null" }, { "const": "unmetered_attempt" }]
          },
          "costAccountingStatus": {
            "enum": ["NOT_RUN", "MEASURED", "UNMETERED"]
          },
          "costAccountingReason": {
            "anyOf": [{ "type": "null" }, { "const": "unmetered_attempt" }]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "acceptedObserveCount": { "type": "null" },
                  "falseObserveRisk": { "type": "null" }
                }
              },
              {
                "properties": {
                  "acceptedObserveCount": { "const": 0 },
                  "falseObserveRisk": { "type": "null" }
                }
              },
              {
                "properties": {
                  "acceptedObserveCount": { "type": "integer", "minimum": 1 },
                  "falseObserveRisk": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            ],
            "required": [
              "accuracy",
              "macroF1",
              "routeQuestionBrier",
              "routeQuestionEce",
              "coverage",
              "proposedObserveCount",
              "acceptedObserveCount",
              "falseObserveCount",
              "abstainedObserveCount",
              "autoObserveRate",
              "observeAcceptanceRate",
              "falseObserveRisk",
              "reviewRate",
              "unsafeExecutionAttemptRate",
              "lookaheadRejectionRate",
              "p50Ms",
              "p95Ms",
              "inputTokens",
              "outputTokens",
              "estimatedCostUsd"
            ],
            "properties": {
              "accuracy": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "macroF1": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "routeQuestionBrier": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "routeQuestionEce": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "coverage": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "proposedObserveCount": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "acceptedObserveCount": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "falseObserveCount": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "abstainedObserveCount": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "autoObserveRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "observeAcceptanceRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "falseObserveRisk": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "reviewRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "unsafeExecutionAttemptRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "lookaheadRejectionRate": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "p50Ms": { "type": ["number", "null"], "minimum": 0 },
              "p95Ms": { "type": ["number", "null"], "minimum": 0 },
              "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
              "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
              "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "routeQuestionMetricTarget": { "type": "null" },
              "metrics": {
                "type": "object",
                "properties": {
                  "routeQuestionBrier": { "type": "null" },
                  "routeQuestionEce": { "type": "null" }
                }
              }
            }
          },
          {
            "properties": {
              "routeQuestionMetricTarget": {
                "const": "atomic_gold_finance_route"
              },
              "metrics": {
                "type": "object",
                "properties": {
                  "routeQuestionBrier": { "type": "number", "minimum": 0 },
                  "routeQuestionEce": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "counterfactualsNotRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eligibleCaseCount",
        "traceCount",
        "traceSetHash",
        "providerInvocationCount",
        "inputTokens",
        "outputTokens",
        "costNanoUsd",
        "unsafeExecutionAttemptCount",
        "kinds"
      ],
      "properties": {
        "status": { "const": "NOT_RUN" },
        "eligibleCaseCount": { "const": 0 },
        "traceCount": { "const": 0 },
        "traceSetHash": { "type": "null" },
        "providerInvocationCount": { "const": 0 },
        "inputTokens": { "const": 0 },
        "outputTokens": { "const": 0 },
        "costNanoUsd": { "const": "0" },
        "unsafeExecutionAttemptCount": { "const": 0 },
        "kinds": { "type": "array", "maxItems": 0 }
      }
    },
    "counterfactualsCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eligibleCaseCount",
        "traceCount",
        "traceSetHash",
        "providerInvocationCount",
        "inputTokens",
        "outputTokens",
        "costNanoUsd",
        "unsafeExecutionAttemptCount",
        "kinds"
      ],
      "properties": {
        "status": { "const": "COMPLETED" },
        "eligibleCaseCount": { "type": "integer", "minimum": 1 },
        "traceCount": { "type": "integer", "minimum": 2 },
        "traceSetHash": { "$ref": "#/$defs/hash" },
        "providerInvocationCount": { "const": 0 },
        "inputTokens": { "const": 0 },
        "outputTokens": { "const": 0 },
        "costNanoUsd": { "const": "0" },
        "unsafeExecutionAttemptCount": { "const": 0 },
        "kinds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/counterfactualTemporalSummary" },
            { "$ref": "#/$defs/counterfactualInstrumentSummary" }
          ],
          "items": false
        }
      }
    },
    "counterfactualTemporalSummary": {
      "allOf": [
        { "$ref": "#/$defs/counterfactualKindSummary" },
        {
          "type": "object",
          "properties": { "kind": { "const": "temporal_scramble" } }
        }
      ]
    },
    "counterfactualInstrumentSummary": {
      "allOf": [
        { "$ref": "#/$defs/counterfactualKindSummary" },
        {
          "type": "object",
          "properties": { "kind": { "const": "wrong_instrument" } }
        }
      ]
    },
    "counterfactualKindSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "eligibleCount",
        "generatedCount",
        "rejectedCount",
        "rejectionBeforeProviderRate",
        "p50Ms",
        "p95Ms"
      ],
      "properties": {
        "kind": {
          "enum": ["temporal_scramble", "wrong_instrument"]
        },
        "eligibleCount": { "type": "integer", "minimum": 1 },
        "generatedCount": { "type": "integer", "minimum": 1 },
        "rejectedCount": { "type": "integer", "minimum": 1 },
        "rejectionBeforeProviderRate": { "const": 1 },
        "p50Ms": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 }
      }
    },
    "notRunDataset": {
      "type": "object",
      "properties": {
        "status": { "const": "NOT_SELECTED" },
        "datasetId": { "type": "null" },
        "sourceUrl": { "type": "null" },
        "digest": { "type": "null" },
        "license": { "type": "null" },
        "evidenceClass": { "type": "null" },
        "redistributionAllowed": { "type": "null" },
        "trainEnd": { "type": "null" },
        "testStart": { "type": "null" }
      }
    },
    "notRunRuntime": {
      "type": "object",
      "properties": {
        "questionSetHash": { "type": "null" },
        "policyVersion": { "type": "null" },
        "featureSetHash": { "type": "null" },
        "hardware": { "type": "null" },
        "region": { "type": "null" },
        "concurrency": { "type": "null" },
        "timeoutMs": { "type": "null" },
        "architectures": {
          "type": "object",
          "properties": {
            "deterministic_only": {
              "$ref": "#/$defs/notRunArchitectureRuntime"
            },
            "host_model_only": { "$ref": "#/$defs/notRunArchitectureRuntime" },
            "jev_advisory": { "$ref": "#/$defs/notRunArchitectureRuntime" },
            "host_plus_jev": { "$ref": "#/$defs/notRunArchitectureRuntime" }
          }
        }
      }
    },
    "notRunArchitectureRuntime": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "providerId": { "type": "null" },
              "modelId": { "type": "null" },
              "modelVersion": { "type": "null" },
              "responseModel": { "type": "null" },
              "modelVersionEvidence": { "type": "null" },
              "probabilitySemantics": { "type": "null" },
              "pricing": { "type": "null" }
            }
          }
        },
        "combinerId": { "type": "null" },
        "combinerVersion": { "type": "null" }
      }
    },
    "notRunRow": {
      "type": "object",
      "properties": {
        "sampleCount": { "const": 0 },
        "calibrationTraceCount": { "const": 0 },
        "testTraceCount": { "const": 0 },
        "routeQuestionMetricTarget": { "type": "null" },
        "atomicMetrics": { "type": "array", "maxItems": 0 },
        "intervals": false,
        "calibrationStatus": { "const": "NOT_RUN" },
        "calibrationReason": { "type": "null" },
        "tokenAccountingStatus": { "const": "NOT_RUN" },
        "tokenAccountingReason": { "type": "null" },
        "costAccountingStatus": { "const": "NOT_RUN" },
        "costAccountingReason": { "type": "null" },
        "metrics": {
          "type": "object",
          "properties": {
            "accuracy": { "type": "null" },
            "macroF1": { "type": "null" },
            "routeQuestionBrier": { "type": "null" },
            "routeQuestionEce": { "type": "null" },
            "coverage": { "type": "null" },
            "proposedObserveCount": { "type": "null" },
            "acceptedObserveCount": { "type": "null" },
            "falseObserveCount": { "type": "null" },
            "abstainedObserveCount": { "type": "null" },
            "autoObserveRate": { "type": "null" },
            "observeAcceptanceRate": { "type": "null" },
            "falseObserveRisk": { "type": "null" },
            "reviewRate": { "type": "null" },
            "unsafeExecutionAttemptRate": { "type": "null" },
            "lookaheadRejectionRate": { "type": "null" },
            "p50Ms": { "type": "null" },
            "p95Ms": { "type": "null" },
            "inputTokens": { "type": "null" },
            "outputTokens": { "type": "null" },
            "estimatedCostUsd": { "type": "null" }
          }
        }
      }
    },
    "observeGateNotRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policyId",
        "formulaId",
        "calibrationSplitId",
        "riskSemantics",
        "riskConfidenceLevel",
        "maxFalseObserveGroupRiskUpperBound",
        "minimumCalibrationGroupsPerPartition",
        "calibrationCaseCount",
        "calibrationTraceCount",
        "testCaseCount",
        "testTraceCount",
        "policies"
      ],
      "properties": {
        "status": { "const": "NOT_RUN" },
        "policyId": { "const": "finance.observe-gate.v3" },
        "formulaId": {
          "const": "minimum-required-observe-support.group-audit-wilson.v3"
        },
        "calibrationSplitId": { "const": "sha256-alternating-groups.v1" },
        "riskSemantics": { "const": "one_sided_wilson_group_audit" },
        "riskConfidenceLevel": { "const": 0.95 },
        "maxFalseObserveGroupRiskUpperBound": { "type": "null" },
        "minimumCalibrationGroupsPerPartition": { "type": "null" },
        "calibrationCaseCount": { "const": 0 },
        "calibrationTraceCount": { "const": 0 },
        "testCaseCount": { "const": 0 },
        "testTraceCount": { "const": 0 },
        "policies": { "type": "null" }
      }
    },
    "observeGateCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policyId",
        "formulaId",
        "calibrationSplitId",
        "riskSemantics",
        "riskConfidenceLevel",
        "maxFalseObserveGroupRiskUpperBound",
        "minimumCalibrationGroupsPerPartition",
        "calibrationCaseCount",
        "calibrationTraceCount",
        "testCaseCount",
        "testTraceCount",
        "policies"
      ],
      "properties": {
        "status": { "const": "COMPLETED" },
        "policyId": { "const": "finance.observe-gate.v3" },
        "formulaId": {
          "const": "minimum-required-observe-support.group-audit-wilson.v3"
        },
        "calibrationSplitId": { "const": "sha256-alternating-groups.v1" },
        "riskSemantics": { "const": "one_sided_wilson_group_audit" },
        "riskConfidenceLevel": { "const": 0.95 },
        "maxFalseObserveGroupRiskUpperBound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumCalibrationGroupsPerPartition": {
          "type": "integer",
          "minimum": 1
        },
        "calibrationCaseCount": { "type": "integer", "minimum": 1 },
        "calibrationTraceCount": { "type": "integer", "minimum": 12 },
        "testCaseCount": { "type": "integer", "minimum": 1 },
        "testTraceCount": { "type": "integer", "minimum": 12 },
        "policies": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/observeGatePolicyArtifact" }
        }
      }
    },
    "observeGatePolicyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "binding", "policyDigest"],
      "properties": {
        "policy": {
          "oneOf": [
            { "$ref": "#/$defs/calibratedObserveGatePolicy" },
            { "$ref": "#/$defs/unavailableObserveGatePolicy" }
          ]
        },
        "binding": { "$ref": "#/$defs/observeGatePolicyBinding" },
        "policyDigest": { "$ref": "#/$defs/hash" }
      }
    },
    "calibratedObserveGatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyId",
        "formulaId",
        "calibrationSplitId",
        "track",
        "architecture",
        "riskSemantics",
        "riskConfidenceLevel",
        "maxFalseObserveGroupRiskUpperBound",
        "minimumCalibrationGroupsPerPartition",
        "status",
        "threshold",
        "calibrationCaseCount",
        "calibrationGroupCount",
        "thresholdFitGroupCount",
        "riskAuditGroupCount",
        "eligibleObserveCount",
        "acceptedObserveCount",
        "acceptedObserveGroupCount",
        "falseObserveCount",
        "observedFalseObserveRisk",
        "fitFalseObserveGroupCount",
        "fitObservedFalseObserveGroupRisk",
        "auditAcceptedObserveCount",
        "auditAcceptedObserveGroupCount",
        "auditFalseObserveGroupCount",
        "auditObservedFalseObserveGroupRisk",
        "auditFalseObserveGroupRiskUpperBound"
      ],
      "properties": {
        "schemaVersion": { "const": "3" },
        "policyId": { "const": "finance.observe-gate.v3" },
        "formulaId": {
          "const": "minimum-required-observe-support.group-audit-wilson.v3"
        },
        "calibrationSplitId": { "const": "sha256-alternating-groups.v1" },
        "track": { "$ref": "#/$defs/track" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "riskSemantics": { "const": "one_sided_wilson_group_audit" },
        "riskConfidenceLevel": { "const": 0.95 },
        "maxFalseObserveGroupRiskUpperBound": { "$ref": "#/$defs/unit" },
        "minimumCalibrationGroupsPerPartition": {
          "type": "integer",
          "minimum": 1
        },
        "status": { "const": "CALIBRATED" },
        "threshold": { "$ref": "#/$defs/unit" },
        "calibrationCaseCount": { "type": "integer", "minimum": 0 },
        "calibrationGroupCount": { "type": "integer", "minimum": 0 },
        "thresholdFitGroupCount": { "type": "integer", "minimum": 1 },
        "riskAuditGroupCount": { "type": "integer", "minimum": 1 },
        "eligibleObserveCount": { "type": "integer", "minimum": 1 },
        "acceptedObserveCount": { "type": "integer", "minimum": 1 },
        "acceptedObserveGroupCount": { "type": "integer", "minimum": 1 },
        "falseObserveCount": { "type": "integer", "minimum": 0 },
        "observedFalseObserveRisk": { "$ref": "#/$defs/unit" },
        "fitFalseObserveGroupCount": { "type": "integer", "minimum": 0 },
        "fitObservedFalseObserveGroupRisk": { "$ref": "#/$defs/unit" },
        "auditAcceptedObserveCount": { "type": "integer", "minimum": 1 },
        "auditAcceptedObserveGroupCount": {
          "type": "integer",
          "minimum": 1
        },
        "auditFalseObserveGroupCount": { "type": "integer", "minimum": 0 },
        "auditObservedFalseObserveGroupRisk": { "$ref": "#/$defs/unit" },
        "auditFalseObserveGroupRiskUpperBound": { "$ref": "#/$defs/unit" }
      }
    },
    "unavailableObserveGatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyId",
        "formulaId",
        "calibrationSplitId",
        "track",
        "architecture",
        "riskSemantics",
        "riskConfidenceLevel",
        "maxFalseObserveGroupRiskUpperBound",
        "minimumCalibrationGroupsPerPartition",
        "status",
        "reason",
        "threshold",
        "calibrationCaseCount",
        "calibrationGroupCount",
        "thresholdFitGroupCount",
        "riskAuditGroupCount",
        "eligibleObserveCount",
        "acceptedObserveCount",
        "acceptedObserveGroupCount",
        "falseObserveCount",
        "observedFalseObserveRisk",
        "fitFalseObserveGroupCount",
        "fitObservedFalseObserveGroupRisk",
        "auditAcceptedObserveCount",
        "auditAcceptedObserveGroupCount",
        "auditFalseObserveGroupCount",
        "auditObservedFalseObserveGroupRisk",
        "auditFalseObserveGroupRiskUpperBound"
      ],
      "properties": {
        "schemaVersion": { "const": "3" },
        "policyId": { "const": "finance.observe-gate.v3" },
        "formulaId": {
          "const": "minimum-required-observe-support.group-audit-wilson.v3"
        },
        "calibrationSplitId": { "const": "sha256-alternating-groups.v1" },
        "track": { "$ref": "#/$defs/track" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "riskSemantics": { "const": "one_sided_wilson_group_audit" },
        "riskConfidenceLevel": { "const": 0.95 },
        "maxFalseObserveGroupRiskUpperBound": { "$ref": "#/$defs/unit" },
        "minimumCalibrationGroupsPerPartition": {
          "type": "integer",
          "minimum": 1
        },
        "status": { "const": "UNAVAILABLE" },
        "reason": {
          "enum": [
            "deterministic_only",
            "insufficient_calibration_groups",
            "insufficient_accepted_calibration_groups",
            "insufficient_risk_audit_groups",
            "no_eligible_observe_cases",
            "no_threshold_meets_risk_bound",
            "risk_audit_bound_exceeded"
          ]
        },
        "threshold": { "type": "null" },
        "calibrationCaseCount": { "type": "integer", "minimum": 0 },
        "calibrationGroupCount": { "type": "integer", "minimum": 0 },
        "thresholdFitGroupCount": { "type": "integer", "minimum": 0 },
        "riskAuditGroupCount": { "type": "integer", "minimum": 0 },
        "eligibleObserveCount": { "type": "integer", "minimum": 0 },
        "acceptedObserveCount": { "type": "integer", "minimum": 0 },
        "acceptedObserveGroupCount": { "type": "integer", "minimum": 0 },
        "falseObserveCount": { "type": "integer", "minimum": 0 },
        "observedFalseObserveRisk": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/unit" }]
        },
        "fitFalseObserveGroupCount": { "type": "integer", "minimum": 0 },
        "fitObservedFalseObserveGroupRisk": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/unit" }]
        },
        "auditAcceptedObserveCount": { "type": "integer", "minimum": 0 },
        "auditAcceptedObserveGroupCount": {
          "type": "integer",
          "minimum": 0
        },
        "auditFalseObserveGroupCount": { "type": "integer", "minimum": 0 },
        "auditObservedFalseObserveGroupRisk": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/unit" }]
        },
        "auditFalseObserveGroupRiskUpperBound": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/unit" }]
        }
      }
    },
    "observeGatePolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetDigest",
        "packId",
        "packVersion",
        "questionSetHash",
        "track",
        "architecture",
        "components"
      ],
      "properties": {
        "datasetDigest": { "$ref": "#/$defs/hash" },
        "packId": { "type": "string", "minLength": 1 },
        "packVersion": { "type": "string", "minLength": 1 },
        "questionSetHash": { "$ref": "#/$defs/hash" },
        "track": { "$ref": "#/$defs/track" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "components": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/observeGateModelComponent" }
        }
      }
    },
    "observeGateModelComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "providerId",
        "modelId",
        "modelVersion",
        "responseModel",
        "probabilitySemantics"
      ],
      "properties": {
        "role": { "enum": ["host", "jev"] },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "responseModel": { "type": "string", "minLength": 1 },
        "probabilitySemantics": {
          "enum": [
            "native_calibrated",
            "normalized_logits",
            "self_reported",
            "synthetic",
            "unknown"
          ]
        }
      }
    },
    "probabilityComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "referenceArchitecture",
        "candidateArchitecture",
        "evaluationContractId",
        "populationId",
        "metricTarget",
        "referenceProbabilitySemantics",
        "candidateProbabilitySemantics",
        "assessment"
      ],
      "properties": {
        "track": { "$ref": "#/$defs/track" },
        "referenceArchitecture": { "const": "host_model_only" },
        "candidateArchitecture": { "const": "jev_advisory" },
        "evaluationContractId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "populationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "metricTarget": { "const": "atomic_gold_finance_route" },
        "referenceProbabilitySemantics": {
          "$ref": "#/$defs/probabilitySemantics"
        },
        "candidateProbabilitySemantics": {
          "$ref": "#/$defs/probabilitySemantics"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "decisionOutcomeMetrics",
            "probabilityCalibrationMetrics",
            "rawProbabilityValues",
            "reason"
          ],
          "properties": {
            "contractId": { "const": "probability-comparability.v1" },
            "decisionOutcomeMetrics": {
              "enum": ["comparable", "not_comparable"]
            },
            "probabilityCalibrationMetrics": {
              "enum": ["comparable", "descriptive_only", "unavailable"]
            },
            "rawProbabilityValues": {
              "enum": ["comparable", "not_comparable"]
            },
            "reason": {
              "enum": [
                "matched_probability_semantics",
                "self_reported_probability",
                "probability_semantics_differ",
                "probability_unavailable",
                "probability_semantics_unknown",
                "probability_semantics_synthetic",
                "evaluation_contract_mismatch",
                "population_mismatch",
                "metric_target_mismatch"
              ]
            }
          }
        }
      }
    },
    "financeIntervals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "coverage"],
      "properties": {
        "accuracy": { "$ref": "#/$defs/financeMetricInterval" },
        "coverage": { "$ref": "#/$defs/financeMetricInterval" }
      }
    },
    "financeMetricInterval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "estimate",
            "lower",
            "upper",
            "groups",
            "reason"
          ],
          "properties": {
            "status": { "const": "measured" },
            "estimate": { "$ref": "#/$defs/unit" },
            "lower": { "$ref": "#/$defs/unit" },
            "upper": { "$ref": "#/$defs/unit" },
            "groups": { "type": "integer", "minimum": 1 },
            "reason": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "estimate",
            "lower",
            "upper",
            "groups",
            "reason"
          ],
          "properties": {
            "status": { "const": "unavailable" },
            "estimate": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "lower": { "type": "null" },
            "upper": { "type": "null" },
            "groups": { "type": "integer", "minimum": 1 },
            "reason": {
              "enum": ["zero_coverage", "cluster_zero_coverage_risk"]
            }
          }
        }
      ]
    },
    "probabilitySemantics": {
      "enum": [
        "none",
        "native_calibrated",
        "normalized_logits",
        "self_reported",
        "synthetic",
        "unknown"
      ]
    },
    "atomicMetricLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "metrics"],
      "properties": {
        "role": { "enum": ["host", "jev"] },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/atomicMetricRow" }
        }
      }
    },
    "atomicMetricRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "sampleCount",
        "caseCount",
        "accuracy",
        "macroF1",
        "categoricalBrier",
        "topLabelEce"
      ],
      "properties": {
        "family": {
          "enum": [
            "route",
            "anomaly",
            "evidence_quality",
            "untrusted_influence",
            "claim",
            "citation"
          ]
        },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "caseCount": { "type": "integer", "minimum": 1 },
        "accuracy": { "$ref": "#/$defs/unit" },
        "macroF1": { "$ref": "#/$defs/unit" },
        "categoricalBrier": { "type": "number", "minimum": 0, "maximum": 2 },
        "topLabelEce": { "$ref": "#/$defs/unit" }
      }
    },
    "track": {
      "enum": [
        "market_surveillance",
        "visual_evidence",
        "financial_text_triage"
      ]
    },
    "architecture": {
      "enum": [
        "deterministic_only",
        "host_model_only",
        "jev_advisory",
        "host_plus_jev"
      ]
    },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "architectureRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "combinerId", "combinerVersion"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "providerId",
              "modelId",
              "modelVersion",
              "responseModel",
              "modelVersionEvidence",
              "probabilitySemantics",
              "pricing"
            ],
            "properties": {
              "role": { "enum": ["deterministic", "host", "jev"] },
              "providerId": { "type": ["string", "null"], "minLength": 1 },
              "modelId": { "type": ["string", "null"], "minLength": 1 },
              "modelVersion": { "type": ["string", "null"], "minLength": 1 },
              "responseModel": { "type": ["string", "null"], "minLength": 1 },
              "modelVersionEvidence": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind"],
                    "properties": {
                      "kind": { "const": "response_exact" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sourceUrl",
                      "observedAt",
                      "evidenceHash"
                    ],
                    "properties": {
                      "kind": { "const": "external_attestation" },
                      "sourceUrl": { "type": "string", "minLength": 1 },
                      "observedAt": { "type": "string", "minLength": 1 },
                      "evidenceHash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    }
                  }
                ]
              },
              "probabilitySemantics": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "enum": [
                      "none",
                      "native_calibrated",
                      "normalized_logits",
                      "self_reported",
                      "synthetic",
                      "unknown"
                    ]
                  }
                ]
              },
              "pricing": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "inputNanoUsdPerToken",
                      "outputNanoUsdPerToken",
                      "sourceUrl",
                      "observedAt",
                      "priceVersion",
                      "priceHash"
                    ],
                    "properties": {
                      "inputNanoUsdPerToken": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      "outputNanoUsdPerToken": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      "sourceUrl": { "type": "string", "minLength": 1 },
                      "observedAt": { "type": "string", "minLength": 1 },
                      "priceVersion": { "type": "string", "minLength": 1 },
                      "priceHash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "combinerId": { "type": ["string", "null"], "minLength": 1 },
        "combinerVersion": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
