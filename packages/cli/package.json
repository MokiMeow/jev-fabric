{
  "name": "@mokimeow/jev-fabric-cli",
  "version": "0.1.0-alpha.1",
  "description": "Cross-platform command line interface for Jev Fabric.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "jev-fabric": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "test": "vitest run --root ../.. packages/cli/test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsdown",
    "lint": "biome lint src test",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@mokimeow/jev-fabric-core": "workspace:*",
    "@mokimeow/jev-fabric-evals": "workspace:*",
    "@mokimeow/jev-fabric-mcp": "workspace:*",
    "@mokimeow/jev-fabric-packs": "workspace:*",
    "@mokimeow/jev-fabric-protocol": "workspace:*",
    "@mokimeow/jev-fabric-provider-typesafe": "workspace:*",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MokiMeow/jev-fabric.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MokiMeow/jev-fabric#readme",
  "bugs": {
    "url": "https://github.com/MokiMeow/jev-fabric/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
