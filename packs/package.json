{
  "name": "@mokimeow/jev-fabric-packs",
  "version": "0.1.0-alpha.1",
  "description": "Composable, bounded decision packs for Jev Fabric.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "route/fixtures.jsonl",
    "screen/fixtures.jsonl",
    "rank/fixtures.jsonl",
    "verify/fixtures.jsonl",
    "risk/fixtures.jsonl",
    "progress/fixtures.jsonl",
    "completion/fixtures.jsonl",
    "finance-surveillance/fixtures.jsonl",
    "fintech-exception/fixtures.jsonl"
  ],
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "test": "vitest run --root .. packs/test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsdown",
    "lint": "biome lint .",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@mokimeow/jev-fabric-core": "workspace:*",
    "@mokimeow/jev-fabric-protocol": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MokiMeow/jev-fabric.git",
    "directory": "packs"
  },
  "homepage": "https://github.com/MokiMeow/jev-fabric#readme",
  "bugs": {
    "url": "https://github.com/MokiMeow/jev-fabric/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
